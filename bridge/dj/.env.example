# Copy to .env beside bridge.mjs and fill in. .env is gitignored.

# The wedding app.
WEDDING_URL=https://wedding.yourdomain.nz

# The same value as DJ_BRIDGE_TOKEN on the server.
DJ_BRIDGE_TOKEN=

# Optional:
