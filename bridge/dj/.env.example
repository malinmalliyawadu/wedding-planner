# Copy to .env beside bridge.mjs and fill in. .env is gitignored.

# The wedding app.
WEDDING_URL=https://wedding.yourdomain.nz

# The same value as DJ_BRIDGE_TOKEN on the server.
DJ_BRIDGE_TOKEN=

# Claude operates djay by computer use (the default driver), billed to
# this key. From the Anthropic Console: console.anthropic.com
ANTHROPIC_API_KEY=

# Optional:
# DJ_DRIVER=keys            # fixed keyboard shortcuts instead of Claude
# DJ_DRIVER=fake            # rehearse without djay
# DJ_CLAUDE_MODEL=sonnet    # quicker and cheaper than opus (the default)
# DJ_NOW_PLAYING=driver     # read the decks instead of macOS Now Playing
# DJ_WATCH_SECONDS=30       # how often Claude reads the decks, without Now Playing
# DJ_WATCH_FAST_SECONDS=5   # ...as a song is due to end
# DJ_WATCH_LEAD_SECONDS=20  # ...starting this long before its end
# DJ_APP="djay Pro"        # only if djay is not found by itself
# DJ_POLL_MS=3000
# DJ_KEEP_AWAKE=0           # let the Mac sleep
