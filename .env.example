# Connection string for Postgres. In Coolify, point this at the internal
# Postgres service. Locally, docker-compose exposes it on port 5433.
DATABASE_URL=postgres://wedding:wedding@localhost:5433/wedding

# The planner's way in. This is the credential you type the first time,
# on a device with no passkey yet, and the fallback if you ever lose every
# passkey you have registered. Set it before the app is reachable: with no
# password and no passkey, /login says so and nobody can get in.
#
# Make it long and random - it is one secret shared by two people, it is
# never rotated by accident, and it is also what a calendar client puts in
# the tasks.ics URL. Generate one with:
#   openssl rand -base64 24
APP_PASSWORD=change-me

# Only needed if the app cannot work out its own public origin.
#
# Passkeys are bound to a domain, so the app has to know which domain it
# is - normally it reads that off the request (x-forwarded-host and
# x-forwarded-proto, which Traefik sets). Set this if sign-in complains
# about the domain, and set it to exactly the origin in the address bar,
# scheme and all. Getting it wrong stops passkeys working; it cannot let
# anyone in, because the browser signs over the real origin regardless.
# APP_ORIGIN=https://wedding.yourdomain.nz

# Object storage for guest photographs - Cloudflare R2 in production.
# Everything except the shared album works without these: the upload
# screen says it is not set up rather than failing at a guest. See the
# object storage section of DEPLOYMENT.md for creating the bucket, the
# API token and the bucket's CORS rule.
#
# Locally, `docker compose up -d` runs SeaweedFS on 9010 with the bucket
# already made; these are its values:
#   S3_BUCKET=wedding-photos
#   S3_ACCESS_KEY_ID=wedding
#   S3_SECRET_ACCESS_KEY=weddingsecret
#   S3_ENDPOINT=http://localhost:9010
# S3_BUCKET=wedding-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# R2's S3 endpoint is the account's, not the bucket's: the account id is
# on the R2 overview page. Omit only on real AWS.
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# R2 wants "auto" and reads the default (us-east-1) as the same thing;
# SeaweedFS, used locally, takes the default too. Set only if a provider insists.
# S3_REGION=auto
# Path style is the default and works on R2; set false only if your
# provider needs virtual-host style addressing.
# S3_FORCE_PATH_STYLE=true

# The photo booth's way in. The booth at the venue sends each session's
# photograph to /api/booth/photos with this as a bearer token, so its
# prints land in the album next to what guests upload; the same value
# goes in the booth's GALLERY_SYNC_TOKEN. Unset, the door is shut and
# the booth is told so. Needs the S3_* variables too. Generate one with:
#   openssl rand -base64 24
# BOOTH_SYNC_TOKEN=

# The DJ bridge's way in. The script on the laptop running djay Pro
# (bridge/dj/) polls /api/dj/bridge with this as a bearer token, to hand
# requests to djay and press Skip when the floor votes a song off. The
# same value goes in the bridge's DJ_BRIDGE_TOKEN. Unset, the door is
# shut and the dance floor still works by hand from /admin/dance-floor.
#   openssl rand -base64 24
# DJ_BRIDGE_TOKEN=
