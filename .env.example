# Connection string for Postgres. In Coolify, point this at the internal
# Postgres service. Locally, docker-compose exposes it on port 5433.
DATABASE_URL=postgres://wedding:wedding@localhost:5433/wedding

# The planner's way in. This is the credential you type the first time,
# on a device with no passkey yet, and the fallback if you ever lose every
# passkey you have registered. Set it before the app is reachable: with no
# password and no passkey, /login says so and nobody can get in.
#
# Make it long and random - it is one secret shared by two people, it is
# never rotated by accident, and it is also what a calendar client puts in
# the tasks.ics URL. Generate one with:
#   openssl rand -base64 24
APP_PASSWORD=change-me

# Only needed if the app cannot work out its own public origin.
#
# Passkeys are bound to a domain, so the app has to know which domain it
# is - normally it reads that off the request (x-forwarded-host and
# x-forwarded-proto, which Traefik sets). Set this if sign-in complains
# about the domain, and set it to exactly the origin in the address bar,
# scheme and all. Getting it wrong stops passkeys working; it cannot let
# anyone in, because the browser signs over the real origin regardless.
# APP_ORIGIN=https://wedding.yourdomain.nz

# Object storage for guest photographs. Everything except the shared
# album works without these: the upload screen says it is not set up
# rather than failing at a guest. See the object storage section of
# DEPLOYMENT.md, including the bucket's CORS rule.
# S3_BUCKET=wedding-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Endpoint of your S3-compatible provider. Omit only on real AWS.
# S3_ENDPOINT=https://ap-south-1.vultrobjects.com
# Ignored by most non-AWS providers, but the SDK insists on one.
# S3_REGION=us-east-1
# Path style is the default; set false only if your provider needs
# virtual-host style addressing.
# S3_FORCE_PATH_STYLE=true
